{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "filedropper-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  },

  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  "vars": {
    "UPSTASH_BLOB_URL": "https://bd944db9fbf7.blob.upstash.io",
    "PUBLIC_API_ORIGIN": "https://filedropper-api.sonora-online.workers.dev",
    "MAX_FILE_SIZE_MB": "500",
    "MAX_FILES_PER_UPLOAD": "4",
    "DEFAULT_TTL_HOURS": "24",
    "ADMIN_LOGINS": "MaxDiWay"
  }
}